{
  "$schema": "design-tokens",
  "name": "arkamaya-design-tokens",
  "version": "1.0.0",

  "color": {
    "background": {
      "primary":   { "value": "#F2EAD5", "name": "Butter",         "use": "Page background, cards" },
      "secondary": { "value": "#F5E6C8", "name": "Lighter butter", "use": "Subtle surface, hover state" },
      "tertiary":  { "value": "#EBE0C8", "name": "Aged butter",    "use": "Inset surfaces, footers" }
    },
    "ink": {
      "primary":   { "value": "#201410", "name": "Espresso Black", "use": "Body text, primary lines" },
      "secondary": { "value": "#4A2618", "name": "Cocoa Ash",      "use": "Secondary text, borders" },
      "tertiary":  { "value": "#6B4226", "name": "Caramel",        "use": "Tertiary text, hairlines" }
    },
    "accent": {
      "gold":        { "value": "#C9A961", "name": "Gilded",       "use": "Accents, hover, small fills" },
      "burnt":       { "value": "#B85C2C", "name": "Caramelized",  "use": "Highlights, key fills" },
      "burgundy":    { "value": "#6B2737", "name": "Wine reduction", "use": "Rare, for chocolate/wine-based cakes" }
    },
    "semantic": {
      "border":      { "value": "#201410", "alpha": 0.15, "use": "Default hairline borders" },
      "border-strong": { "value": "#201410", "alpha": 0.4, "use": "Emphasis borders" },
      "overlay":     { "value": "#201410", "alpha": 0.6,  "use": "Modal overlays" }
    }
  },

  "typography": {
    "fontFamily": {
      "display": {
        "value": "Gloock, 'Times New Roman', serif",
        "googleFonts": "https://fonts.googleapis.com/css2?family=Gloock&display=swap",
        "use": "Page titles, cake names, brand masthead"
      },
      "serif": {
        "value": "'Crimson Pro', Georgia, serif",
        "googleFonts": "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;1,400;1,500&display=swap",
        "use": "Long-form body, italic pull-quotes, editorial paragraphs"
      },
      "sans": {
        "value": "'Instrument Sans', system-ui, sans-serif",
        "googleFonts": "https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap",
        "use": "UI labels, buttons, navigation, captions"
      },
      "mono": {
        "value": "'Geist Mono', 'JetBrains Mono', ui-monospace, monospace",
        "googleFonts": "https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap",
        "use": "Specimen labels, metadata, pricing, plate numbers"
      }
    },

    "fontSize": {
      "xs":   { "value": "0.75rem",  "px": 12 },
      "sm":   { "value": "0.875rem", "px": 14 },
      "base": { "value": "1rem",     "px": 16 },
      "md":   { "value": "1.125rem", "px": 18 },
      "lg":   { "value": "1.25rem",  "px": 20 },
      "xl":   { "value": "1.5rem",   "px": 24 },
      "2xl":  { "value": "2rem",     "px": 32 },
      "3xl":  { "value": "2.5rem",   "px": 40 },
      "4xl":  { "value": "3.5rem",   "px": 56 },
      "5xl":  { "value": "5rem",     "px": 80 },
      "6xl":  { "value": "7rem",     "px": 112,
                "comment": "Reserved for ARKAMAYA masthead and rare hero displays only" }
    },

    "fontWeight": {
      "regular": 400,
      "medium":  500,
      "bold":    700
    },

    "lineHeight": {
      "tight":    1.1,
      "snug":     1.25,
      "normal":   1.5,
      "relaxed":  1.7,
      "loose":    1.9
    },

    "letterSpacing": {
      "tightest": "-0.02em",
      "tight":    "-0.01em",
      "normal":   "0",
      "wide":     "0.05em",
      "wider":    "0.1em",
      "widest":   "0.18em",
      "masthead": "0.04em",
      "comment":  "Display serif (Gloock) wants positive tracking when set very large. Mono labels want 'wider' or 'widest'."
    }
  },

  "spacing": {
    "comment": "4px-based scale. Prefer the larger end of the scale for editorial breathing room.",
    "0":  "0",
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem",
    "40": "10rem",
    "48": "12rem",
    "56": "14rem",
    "64": "16rem"
  },

  "layout": {
    "container": {
      "max":   "1440px",
      "padding": {
        "mobile":  "1.25rem",
        "tablet":  "2.5rem",
        "desktop": "5rem"
      }
    },
    "grid": {
      "columns": 12,
      "gutter": {
        "mobile":  "1rem",
        "tablet":  "1.5rem",
        "desktop": "2rem"
      }
    },
    "breakpoints": {
      "sm":  "640px",
      "md":  "768px",
      "lg":  "1024px",
      "xl":  "1280px",
      "2xl": "1536px"
    }
  },

  "border": {
    "radius": {
      "none": "0",
      "sm":   "2px",
      "comment-radius": "Default to sharp corners. Rounded corners are reserved for circular elements only (avatars, registration dots)."
    },
    "width": {
      "hairline": "1px",
      "default":  "1px",
      "strong":   "2px"
    }
  },

  "shadow": {
    "comment": "Use sparingly. Editorial doesn't need drop shadows; depth comes from line weight and color.",
    "subtle":  "0 1px 2px rgba(32, 20, 16, 0.05)",
    "card":    "0 4px 12px rgba(32, 20, 16, 0.08)",
    "modal":   "0 24px 48px rgba(32, 20, 16, 0.2)"
  },

  "motion": {
    "duration": {
      "fast":    "150ms",
      "default": "300ms",
      "slow":    "600ms",
      "editorial": "900ms",
      "comment": "Editorial duration is for paragraph reveals and section transitions. Never animate decoratively — only to clarify state."
    },
    "easing": {
      "default":   "cubic-bezier(0.4, 0, 0.2, 1)",
      "editorial": "cubic-bezier(0.22, 1, 0.36, 1)",
      "comment":   "Editorial easing has a soft tail; feels like a paragraph settling rather than a UI snap."
    },
    "3d": {
      "heroRotationSpeed": "0.2 rad/s",
      "mouseParallaxStrength": "0.15",
      "comment": "Hero entremet rotates slowly. Never faster than the eye expects."
    }
  },

  "iconography": {
    "comment": "Use thin-stroke (1-1.5px) line icons. Phosphor Icons (light weight) or Lucide (default) both work. NEVER filled icons.",
    "preferred": "phosphor-icons (light) or lucide-react",
    "strokeWidth": 1.25
  }
}
